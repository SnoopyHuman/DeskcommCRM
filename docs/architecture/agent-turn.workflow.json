{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Turno do Agente de IA",
    "subtitle": "do inbound no WhatsApp à resposta aprovada pelos guardrails",
    "output": "agent-turn.html",
    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "canal",
      "label": "Canal (WAHA)"
    },
    {
      "id": "app",
      "label": "App (ingestão)"
    },
    {
      "id": "worker",
      "label": "Agent Worker"
    },
    {
      "id": "guardrails",
      "label": "Guardrails"
    },
    {
      "id": "humano",
      "label": "Handoff Humano",
      "variant": "exception"
    },
    {
      "id": "config",
      "label": "Config (Memória da Org)",
      "variant": "exception"
    },
    {
      "id": "skills",
      "label": "Skills instaláveis (Fase 2)",
      "variant": "exception"
    },
    {
      "id": "router",
      "label": "Intent Router (Fase 3)",
      "variant": "exception"
    },
    {
      "id": "evolucao",
      "label": "Evolução da IA (Fase 4)",
      "variant": "exception"
    },
    {
      "id": "funil",
      "label": "Funil: etapas + mapeamento",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "inbound",
    "ingest",
    "eventlog",
    "turn",
    "gates",
    "send"
  ],
  "nodes": [
    {
      "id": "inbound",
      "lane": "canal",
      "col": 0,
      "type": "frontend",
      "label": "Msg inbound",
      "sublabel": "cliente escreve"
    },
    {
      "id": "send",
      "lane": "canal",
      "col": 5,
      "type": "frontend",
      "label": "Resposta sai",
      "sublabel": "via WahaAdapter"
    },
    {
      "id": "ingest",
      "lane": "app",
      "col": 1,
      "type": "backend",
      "label": "Webhook ingest",
      "sublabel": "HMAC + dedup"
    },
    {
      "id": "eventlog",
      "lane": "app",
      "col": 3,
      "type": "messagebus",
      "label": "event_log",
      "sublabel": "fila em Postgres"
    },
    {
      "id": "followup",
      "lane": "worker",
      "col": 1,
      "type": "backend",
      "label": "Follow-up cron",
      "sublabel": "reentrada agendada"
    },
    {
      "id": "turn",
      "lane": "worker",
      "col": 3,
      "type": "backend",
      "label": "Turno IA",
      "sublabel": "contexto + RAG + modelo",
      "tag": "runAgentTurn"
    },
    {
      "id": "toolbreaker",
      "lane": "guardrails",
      "col": 2,
      "type": "security",
      "label": "Tool Breaker",
      "sublabel": "circuit breaker de tools"
    },
    {
      "id": "gates",
      "lane": "guardrails",
      "col": 4,
      "type": "security",
      "label": "Before-send",
      "sublabel": "cadeia de 7 gates",
      "tag": "veto = HARD"
    },
    {
      "id": "handoff",
      "lane": "humano",
      "col": 3,
      "type": "frontend",
      "label": "Handoff",
      "sublabel": "humano: roteamento G5"
    },
    {
      "id": "memoryscreen",
      "lane": "config",
      "col": 0,
      "type": "frontend",
      "label": "Memória da Org",
      "sublabel": "tela + API (app/app/ai/memory)"
    },
    {
      "id": "orgmemory",
      "lane": "config",
      "col": 1,
      "type": "backend",
      "label": "org_memory",
      "sublabel": "versão + ponteiro + aprendizados"
    },
    {
      "id": "skillsscreen",
      "lane": "skills",
      "col": 0,
      "type": "frontend",
      "label": "Skills",
      "sublabel": "tela + import .zip (app/app/ai/skills)"
    },
    {
      "id": "skillcatalog",
      "lane": "skills",
      "col": 1,
      "type": "backend",
      "label": "Skill catalog",
      "sublabel": "skill_versions + pointers"
    },
    {
      "id": "routerscreen",
      "lane": "router",
      "col": 0,
      "type": "frontend",
      "label": "Routers",
      "sublabel": "tela + API (app/app/ai/routers)"
    },
    {
      "id": "routerconfig",
      "lane": "router",
      "col": 1,
      "type": "backend",
      "label": "ai_routers",
      "sublabel": "intents + min_confidence + sticky"
    },
    {
      "id": "evolutionscreen",
      "lane": "evolucao",
      "col": 0,
      "type": "frontend",
      "label": "Evolução da IA",
      "sublabel": "tela + API (app/app/ai/evolution)"
    },
    {
      "id": "knowledgesearches",
      "lane": "evolucao",
      "col": 1,
      "type": "backend",
      "label": "Buscas na base",
      "sublabel": "knowledge_searches: hits + limiar"
    },
    {
      "id": "stagesscreen",
      "lane": "funil",
      "col": 0,
      "type": "frontend",
      "label": "Etapas",
      "sublabel": "tela + API: criar · renomear · ganho/perda · arquivar"
    },
    {
      "id": "mappingscreen",
      "lane": "funil",
      "col": 2,
      "type": "frontend",
      "label": "Mapa do funil",
      "sublabel": "tela (settings/tenant/pipelines)"
    },
    {
      "id": "stagehint",
      "lane": "funil",
      "col": 4,
      "type": "database",
      "label": "crm_stages",
      "sublabel": "agent_stage_hint: passo → etapa"
    }
  ],
